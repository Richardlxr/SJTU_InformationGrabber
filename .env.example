# ======== SMTP 邮件配置 ========
# 支持任意 SMTP 服务商（QQ / 163 / Gmail / Outlook 等）
# 常见配置参考表：
#   QQ 邮箱   : smtp.qq.com,      465, SSL (需开启并获取授权码)
#   163 邮箱  : smtp.163.com,     465, SSL (需开启并获取授权码)
#   Gmail     : smtp.gmail.com,   587, STARTTLS (USE_SSL=false) (需设置应用专用密码)
#   Outlook   : smtp.office365.com, 587, STARTTLS (USE_SSL=false)

SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
# SMTP 连接/认证超时（秒），默认 20
SMTP_TIMEOUT=20

# 发件人邮箱地址
SENDER_EMAIL=your_email@qq.com

# 邮箱 SMTP 授权码 / 应用专用密码（绝不是你的登录密码！）
# 获取方式（QQ 邮箱）：设置 → 账户 → POP3/IMAP/SMTP 服务 → 开启 → 生成授权码
# 请妥善保管此文件(.env)，绝对不要提交到任何公开的代码仓库中！
SENDER_PASSWORD=your_authorization_code_here

# 收件人邮箱（可以填自己的邮箱实现自我预警；支持逗号/分号分隔多个地址）
RECEIVER_EMAIL=your_email@qq.com

# ======== 爬虫配置 ========
# 监控的目标页面（逗号分隔，可自行增减，请不要在链接中加多余的空格）
# 默认 7 个页面：教务处面向学生的通知 + 计算机学院 4 个板块 + 致远学院 2 个板块
TARGET_URLS=https://jwc.sjtu.edu.cn/index/mxxsdtz.htm,https://cs.sjtu.edu.cn/xsgz-tzgg-djdy.html,https://cs.sjtu.edu.cn/xsgz-tzgg-txgz.html,https://cs.sjtu.edu.cn/xsgz-tzgg-xssw.html,https://cs.sjtu.edu.cn/xsgz-tzgg-zyfz.html,https://zhiyuan.sjtu.edu.cn/event,https://zhiyuan.sjtu.edu.cn/announcement

# 相对链接兜底解析基准（当页面自身无法确定时使用）
BASE_URL=https://jwc.sjtu.edu.cn/

# 单次 HTTP 请求超时（秒）
REQUEST_TIMEOUT=15

# 单个页面失败后的重试次数（0 表示不重试）
MAX_RETRIES=3

# 并发抓取页面的线程数
MAX_WORKERS=4

# 单个板块最大翻页数（安全上限，防止服务端异常导致死循环）
# 致远学院另外内置「只抓最近 3 页」的策略（新条目在最前）
MAX_PAGES=50

# ======== 运行配置 ========
# 检查间隔（秒），即程序多久去刷一次新公告，默认 300 秒 = 5 分钟
CHECK_INTERVAL=300

# 某个页面连续多少次抓取失败后发送「监控异常」告警邮件（1~100，注释掉则使用默认值 3）
FAILURE_ALERT_THRESHOLD=3

# 同一页面持续失败时，重复提醒的最小间隔（秒，60~2592000），默认 86400 = 1 天
# 新出问题的页面不受此限制，达到上面的阈值就会立即提醒
FAILURE_ALERT_INTERVAL=86400

# 已读状态文件（seen_announcements.json）存放目录
# 留空/注释 = 源码目录下；正式安装（pip）会退回 ~/.local/share/web-bugger
# DATA_DIR=/var/lib/web-bugger
